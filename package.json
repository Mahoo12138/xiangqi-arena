{
  "name": "xiangqi-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc -b",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test:engine": "vite-node src/engine/__tests__/run.ts",
    "test:format": "vite-node src/engine/__tests__/format.ts",
    "test:persist": "vite-node src/engine/__tests__/persist.ts",
    "test:api": "vite-node src/api/__tests__/timeout.ts && vite-node src/api/__tests__/first-byte-timeout.ts",
    "test:db": "vite-node src/db/__tests__/indexeddb.test.ts",
    "test": "npm run test:engine && npm run test:format && npm run test:persist && npm run test:api && npm run test:db"
  },
  "dependencies": {
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-node": "^2.1.5",
    "vue-tsc": "^2.1.10"
  }
}
