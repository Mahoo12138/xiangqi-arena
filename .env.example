# 服务端环境变量（仅 dev server 读取，Key 不会进入浏览器）
LLM_BASE_URL=https://api.aggregator.example.com/v1
LLM_API_KEY=sk-REPLACE_ME

# 模型列表（逗号分隔，会被 Vite 暴露给前端，配置页用下拉框选择）
VITE_LLM_MODELS=deepseek-v4-pro,deepseek-v4-flash-0731,kimi-k2.6,qwen3.8-max,glm-5.2,MiniMax-M2.5

# 可选：单次 LLM 请求总时长上限（毫秒）。不设则随棋局阶段自适应（10 分钟起步，每步 +10s，上限 30 分钟）
# VITE_LLM_TOTAL_TIMEOUT_MS=600000