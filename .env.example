# 服务端环境变量（dev server 与生产 server 均读取，Key 不会进入浏览器）
# 生产环境运行 `npm run start`（node server/index.mjs），同时提供 dist 静态资源
# 与 /api/chat/completions，并执行模型白名单、请求体大小限制与每 IP 限流。
LLM_BASE_URL=https://api.aggregator.example.com/v1
LLM_API_KEY=sk-REPLACE_ME

# 模型列表（逗号分隔，会被 Vite 暴露给前端，配置页用下拉框选择）
VITE_LLM_MODELS=deepseek-v4-pro,deepseek-v4-flash-0731,kimi-k2.6,qwen3.8-max,glm-5.2,MiniMax-M2.5

# 生产服务端模型白名单（强制校验，前端下拉框不是安全控制）。缺省回退到 VITE_LLM_MODELS。
# LLM_ALLOWED_MODELS=deepseek-v4-pro,deepseek-v4-flash-0731

# 生产服务端安全参数（可选）
# PORT=3000
# DIST_DIR=./dist
# MAX_REQUEST_BODY_BYTES=1000000
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=30
# ↑ 每 IP 每个时间窗的请求上限。多标签页并发对弈时按需调大（如 DEFAULT 120），
#   以便容纳多个标签页同时调用 /api/chat/completions。

# 可选：单次 LLM 请求总时长上限（毫秒）。不设则随棋局阶段自适应（10 分钟起步，每步 +10s，上限 30 分钟）
# VITE_LLM_TOTAL_TIMEOUT_MS=600000